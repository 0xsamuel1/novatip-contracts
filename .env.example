# Copy to .env and fill in. Used by scripts/*.sh.

# testnet | mainnet | local
NETWORK=testnet

# Name of a configured Stellar CLI identity (the source/signing account).
# Create one with: stellar keys generate my-identity --network testnet
SOURCE=my-identity

# Admin address stored in the contract at deploy time (G... account or C... contract).
ADMIN=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Stellar Asset Contract id (C...) for the chosen network.
#   testnet:  CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
#   mainnet:  CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
USDC_TOKEN=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/create-jar.sh, update-splits.sh and jar-info.sh ---
# Contract id to operate on. Optional: falls back to the .contract-id file
# written by scripts/deploy.sh.
# CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OWNER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SLUG=@alice

# Single-recipient shorthand — builds a 100% split. Ignored if SPLITS is set.
RECIPIENT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Full splits JSON for multi-recipient jars (optional; overrides RECIPIENT).
# bps values must sum to 10000; at most 20 recipients.
# SPLITS=[{"to":"GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX","bps":6000},{"to":"GYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY","bps":4000}]

# --- For scripts/transfer-jar.sh ---
# Address taking control of the jar. SOURCE must be the jar's *current* owner,
# since only the owner authorizes the transfer; the new owner signs nothing.
NEW_OWNER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- For scripts/set-min-tip.sh ---
# Minimum tip amount in the token's smallest unit (USDC: 1000000 == 1 USDC).
# Zero and negative values are rejected before any network call.
# Unset it, or set it to "none", to clear the minimum (the contract then accepts
# any positive tip again) — clearing is the same as `MIN_TIP=` here, not 0.
MIN_TIP=5000000
# --- For scripts/trustline.sh ---
# Space-separated CLI identity names and/or G... addresses that need a USDC
# trustline before they can tip or receive tips. With SLUG set too, the jar's
# recipients are checked as well.
IDENTITIES=my-identity

# --- For scripts/events.sh ---
# EVENT=tip            # jar_crtd | splits | jar_xfer | min_tip | tip | all (default)
# START_LEDGER=        # default: WINDOW ledgers back from the current ledger
# WINDOW=10000
